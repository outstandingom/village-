# ==============================================================================
# BETUL DISTRICT INTELLIGENCE PLATFORM — ENVIRONMENT TEMPLATE
# Copy to .env in root / apps/web / apps/api / apps/ai-services as needed.
# NEVER commit actual secret keys to version control.
# ==============================================================================

# --- Frontend (apps/web/.env) ---
# Publishable key is safe for browser use with Row Level Security enabled.
VITE_SUPABASE_URL=https://ufxlojhllrvbtcrgfxsn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Backend API (apps/api/.env) ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=https://ufxlojhllrvbtcrgfxsn.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
# Server-side secret key (NEVER expose to frontend)
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_supabase_secret_key
# Python AI & Document Processing Service URL
AI_SERVICE_URL=http://localhost:8000
# Optional LLM / Transcription provider keys (pluggable adapter — SERVER-SIDE ONLY)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=replace_with_openai_api_key_if_using_openai
TRANSCRIPTION_PROVIDER=local-normalizer
# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# --- Python AI Service (apps/ai-services/.env) ---
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
SUPABASE_URL=https://ufxlojhllrvbtcrgfxsn.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_supabase_secret_key
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_ORIGINS=http://localhost:4000,http://localhost:5173
